# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/doubtboard?retryWrites=true&w=majority

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

PORT=5000

# Only needed if the React app is hosted separately (e.g. on Vercel).
# Comma-separated list of allowed origins. Leave empty when the server serves the built client.
CLIENT_URL=
